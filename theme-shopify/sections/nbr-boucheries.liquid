{% comment %}
  Section « Découvrez toutes nos boucheries » (Nabilerie) : fond noir, titre centré, cartes photo verticales
  avec badge, rue et flèche. Les cartes ne sont cliquables que si un lien est renseigné.
{% endcomment %}
{%- assign title_font = section.settings.title_font -%}
<style>
  {{ title_font | font_face: font_display: 'swap' }}
  {%- comment -%} Dans <style> et pas dans un attribut : le nom de la police contient des guillemets. {%- endcomment %}
  #shopify-section-{{ section.id }} .nbr-shops {
    --nbr-shops-title-font: {{ title_font.family }}, {{ title_font.fallback_families }};
    --nbr-shops-title-weight: {{ title_font.weight }};
  }
</style>

<div class="nbr-shops" id="nos-boucheries">
  {%- if section.settings.title != blank -%}
    <h2 class="nbr-shops__title">{{ section.settings.title }}</h2>
  {%- endif -%}

  <div class="nbr-shops__grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="nbr-shops__card" {{ block.shopify_attributes }}>
      {%- else -%}
        <div class="nbr-shops__card" {{ block.shopify_attributes }}>
      {%- endif -%}
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '300, 450, 600, 900, 1200',
              sizes: '(min-width: 750px) 263px, 70vw',
              loading: 'lazy',
              class: 'nbr-shops__image'
          }}
        {%- endif -%}
        <div class="nbr-shops__content">
          {%- if block.settings.badge != blank -%}
            <span class="nbr-shops__badge">
              {{- block.settings.badge -}}
              {%- if block.settings.badge_sup != blank -%}<sup>{{ block.settings.badge_sup }}</sup>{%- endif -%}
            </span>
          {%- endif -%}
          {%- if block.settings.street != blank -%}
            <p class="nbr-shops__street">{{ block.settings.street }}</p>
          {%- endif -%}
          <svg class="nbr-shops__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 12h17M14 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      {%- if block.settings.link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .nbr-shops {
    padding: 100px 20px;
    background: #111111;
    color: #ffffff;
  }

  .nbr-shops__title {
    margin: 0 0 54px;
    /* !important : les titres h2 du thème imposent leur police (Oswald). */
    font-family: var(--nbr-shops-title-font) !important;
    font-weight: var(--nbr-shops-title-weight) !important;
    font-size: clamp(1.6rem, 2.4vw, 2.1rem) !important;
    line-height: 1.2 !important;
    letter-spacing: 0 !important;
    text-align: center;
    text-transform: none !important;
    color: #ffffff;
  }

  .nbr-shops__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 17px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .nbr-shops__card {
    position: relative;
    display: block;
    aspect-ratio: 263 / 422;
    overflow: hidden;
    border-radius: 8px;
    background: #222222;
    color: #ffffff;
    text-decoration: none;
  }

  .nbr-shops__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.7) 0%, rgb(0 0 0 / 0.15) 45%, rgb(0 0 0 / 0.1) 100%);
  }

  .nbr-shops__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nbr-shops__content {
    position: absolute;
    right: 20px;
    bottom: 26px;
    left: 24px;
    z-index: 1;
    font-family: var(--svf-announce-font, 'Helvetica Neue', Arial, sans-serif);
  }

  .nbr-shops__badge {
    display: inline-block;
    padding: 1px 6px 2px;
    border-radius: 3px;
    background: #d4541b;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .nbr-shops__badge sup {
    margin-left: 1px;
    font-size: 0.5em;
    text-transform: none;
  }

  .nbr-shops__street {
    margin: 10px 0 6px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.3;
  }

  .nbr-shops__arrow {
    display: block;
    width: 26px;
    height: 26px;
  }

  @media screen and (max-width: 749px) {
    .nbr-shops {
      padding: 60px 0;
    }

    .nbr-shops__title {
      margin-bottom: 32px;
      padding-inline: 20px;
    }

    .nbr-shops__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 68%;
      gap: 12px;
      padding-inline: 20px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 20px;
      scrollbar-width: none;
    }

    .nbr-shops__grid::-webkit-scrollbar {
      display: none;
    }

    .nbr-shops__card {
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nos boucheries",
  "tag": "section",
  "class": "section-wrapper nbr-shops-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Découvrez toutes nos boucheries"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Police du titre",
      "default": "playfair_display_n7"
    }
  ],
  "blocks": [
    {
      "type": "boucherie",
      "name": "Boucherie",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (verticale)"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (ville / arrondissement)",
          "default": "Paris 11"
        },
        {
          "type": "text",
          "id": "badge_sup",
          "label": "Exposant du badge",
          "default": "ème"
        },
        {
          "type": "text",
          "id": "street",
          "label": "Rue",
          "default": "Rue Oberkampf"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (laisser vide : carte non cliquable)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nos boucheries",
      "blocks": [
        { "type": "boucherie" },
        { "type": "boucherie" },
        { "type": "boucherie" },
        { "type": "boucherie" }
      ]
    }
  ]
}
{% endschema %}
